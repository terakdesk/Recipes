  "ingredients": [
    "150g chorizo",
    "1 onion",
    "1 garlic clove, chopped",
    "2 teaspoons Rosemary, finely chopped",
    "1.5 teaspoon sweet or hot smoked paprika",
    "1 x 400g carton tomatoes",
    "2 x 400g butter beans",
    "230g roasted red peppers, sliced",
    "6 thick slices of hot buttered toast"
  ],
  "method": [
    "Fry chorizo til brown",
    "Fry onion til golden",
    "Add garlic, Rosemary, paprika and fry for another minute",
    "Add tomato, beans and peppers.",
    "Add 200ml water",
    "Simmer for 15 to 20 minutes",
    "Add chorizo and warm through and serve over toast"
