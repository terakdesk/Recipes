{
  "title": "Meatballs 9th Oct 2011",
  "preamble": "Meatballs 9th Oct 2011",
  "ingredients": [
    "170g white bread (crust discarded) as breadcrumbs",
    "170ml milk",
    "1kg ground beef",
    "250g middle bacon",
    "150g grated Parmigiano Reggiano",
    "75g minced fresh parsley leaves &ndash; I used 5.5g Italian seasoning (one sachet)",
    "2 large egg yolks",
    "6 garlic cloves, minced",
    "10g salt",
    "2 teaspoons ground black pepper"
  ],
  "method": [
    "Soak the breadcrumbs in the milk",
    "Mince the beef and bacon together on the middle size cutter.",
    "Mix in all ingredients.",
    "Roll into meatballs!!!"
  ],
